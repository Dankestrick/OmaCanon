#!/usr/bin/env python3
"""OmaCanon helper: brings photos from a Canon camera (USB) into
~/Pictures/Canon/<year>/<date>/, makes previews for the review screen, and
sends the photos she keeps to OmaRAW.

Every command prints one JSON object. The window never talks to the camera
itself; only `download` does, through the gphoto2 command line.

  status                 camera plugged in?, download progress, webcam state
  download               bring every photo not brought before (long job)
  stop                   stop a running download
  days                   day folders with counts
  day <YYYY-MM-DD>       photos of one day, with preview images
  trash                  JSON list of paths on stdin -> moved to the trash
  send                   {"paths", "album", "claude"} on stdin -> imported into OmaRAW
  albums                 OmaRAW's album names
  claude-tag             Claude looks at the queued photos and writes keywords,
                         a title and a caption into OmaRAW (long job)
  open <folder|omaraw>   open a photo folder or OmaRAW floating on top of
                         the OmaCanon window, so nothing hides behind it
  webcam-off             let go of the camera if DSLR Webcam has it
"""

import io
import json
import os
import re
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
# Testing: OMACANON_HOME (or the file ~/.config/omacanon/test-home) moves
# everything (photos, state, cache) somewhere else, and OMACANON_LIMIT (or
# ~/.config/omacanon/test-limit) brings only that many photos per download.
_DEV = HOME / ".config" / "omacanon"
for _name, _file in (("OMACANON_HOME", "test-home"), ("OMACANON_LIMIT", "test-limit"),
                     ("OMACANON_CATALOG", "test-catalog")):
    if not os.environ.get(_name) and (_DEV / _file).is_file():
        os.environ[_name] = (_DEV / _file).read_text().strip()
_TEST = os.environ.get("OMACANON_HOME")
PHOTOS = Path(_TEST) / "Pictures" if _TEST else HOME / "Pictures" / "Canon"
STATE = Path(_TEST) / "state" if _TEST else Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "omacanon"
CACHE = Path(_TEST) / "cache" if _TEST else Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "omacanon"
STAGING = PHOTOS / ".incoming"
JOB = STATE / "job.json"
LEDGER = STATE / "brought.json"   # every photo ever brought over, so deleted ones stay gone
SENT = STATE / "sent.json"        # photos already in OmaRAW
PIDFILE = STATE / "download.pid"
TAGQUEUE = STATE / "claude-queue.json"   # photos waiting for Claude: [{id, path, album}]
TAGJOB = STATE / "claude-job.json"
TAGPID = STATE / "claude.pid"

CANON_VENDOR = "04a9"
PHOTO_EXT = {".cr2", ".cr3", ".jpg", ".jpeg"}


def reply(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def load(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def private_dir(path):
    """State and cache hold photo paths and previews: only she can read them."""
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    return path


def save(path, data):
    """Atomic write through an unpredictable temp file, kept 0600."""
    private_dir(path.parent)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(data))
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


# --- Camera -------------------------------------------------------------------

def camera_usb():
    """A Canon still-image (PTP) device on USB, read from sysfs only, so it
    never takes the camera away from anything using it."""
    for intf in Path("/sys/bus/usb/devices").glob("*:*"):
        try:
            if (intf / "bInterfaceClass").read_text().strip() != "06":
                continue
            dev = intf.parent / intf.name.split(":")[0]
            if (dev / "idVendor").read_text().strip() != CANON_VENDOR:
                continue
            product = (dev / "product").read_text().strip() if (dev / "product").exists() else "Canon camera"
            return {"product": product}
        except OSError:
            continue
    return None


def webcam_active():
    """True when DSLR Webcam has the camera, or is switched on and about to take
    it on plug-in (then OmaCanon must not start a download and race it)."""
    try:
        out = subprocess.run(["systemctl", "--user", "is-active", "dslr-webcam.service"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        if out == "active":
            return True
        if shutil.which("dslr-webcam"):
            info = json.loads(subprocess.run(["dslr-webcam", "status", "--json"], capture_output=True,
                                             text=True, timeout=5).stdout or "{}")
            return bool(info.get("installed") and info.get("enabled"))
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return False


def gphoto(args, timeout=60):
    return subprocess.run(["gphoto2"] + args, capture_output=True, text=True, timeout=timeout)


LIST_LINE = re.compile(r"^#(\d+)\s+(\S+)\s+(?:[a-z-]+\s+)?(\d+) KB\s+(\S+)(?:\s+(\d+))?\s*$")
# File names come from the camera, so only plain names are used (IMG_1234.CR2,
# _MG_1234.JPG): no slashes, no "..", nothing hidden.
SAFE_NAME = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+)*$")


def list_card():
    """Every photo on the card: number (for --get-file), name, size in KB, time."""
    out = gphoto(["--list-files"], timeout=180)
    if out.returncode != 0:
        raise RuntimeError(camera_error(out.stderr))
    files = []
    for line in out.stdout.splitlines():
        m = LIST_LINE.match(line.strip())
        if not m:
            continue
        name = m.group(2)
        if len(name) > 128 or not SAFE_NAME.match(name) or Path(name).suffix.lower() not in PHOTO_EXT:
            continue
        files.append({"n": int(m.group(1)), "name": name, "kb": int(m.group(3)),
                      "mtime": int(m.group(5) or 0)})
    return files


def camera_error(text):
    text = text or ""
    if "Could not claim" in text or "busy" in text.lower():
        return "Another program is using the camera. Close it (or turn the webcam off) and try again."
    if "No camera found" in text or "Could not detect" in text:
        return "The camera isn't answering. Check it's turned on and its WiFi is off."
    return "The camera didn't answer. Turn it off and on, then try again."


def battery():
    out = gphoto(["--get-config", "batterylevel"], timeout=20)
    m = re.search(r"Current:\s*(\S+)", out.stdout)
    return m.group(1) if m else ""


def key(f):
    return f"{f['name']}|{f['kb']}|{f['mtime']}"


# --- Photo files ----------------------------------------------------------------

def tiff_info(data):
    """From a CR2 (a TIFF): the big embedded JPEG, the date taken and the
    orientation. Returns (jpeg bytes or None, 'YYYY:MM:DD HH:MM:SS' or None, orientation)."""
    if data[:2] == b"II":
        e = "<"
    elif data[:2] == b"MM":
        e = ">"
    else:
        return None, None, 1

    def ifd(offset):
        tags = {}
        if offset + 2 > len(data):
            return tags
        count = struct.unpack_from(e + "H", data, offset)[0]
        for i in range(count):
            p = offset + 2 + i * 12
            if p + 12 > len(data):
                break
            tag, typ, n = struct.unpack_from(e + "HHI", data, p)
            if typ == 3 and n == 1:
                value = struct.unpack_from(e + "H", data, p + 8)[0]
            elif typ == 2:
                where = struct.unpack_from(e + "I", data, p + 8)[0] if n > 4 else p + 8
                value = data[where:where + n].split(b"\0")[0].decode(errors="replace")
            else:
                value = struct.unpack_from(e + "I", data, p + 8)[0]
            tags[tag] = value
        return tags

    ifd0 = ifd(struct.unpack_from(e + "I", data, 4)[0])
    jpeg = None
    start, length = ifd0.get(0x0111), ifd0.get(0x0117)
    if isinstance(start, int) and isinstance(length, int) and 0 < start < len(data):
        blob = data[start:start + length]
        if blob[:2] == b"\xff\xd8":
            jpeg = blob
    taken = None
    exif = ifd0.get(0x8769)
    if isinstance(exif, int):
        taken = ifd(exif).get(0x9003)
    return jpeg, taken, ifd0.get(0x0112, 1) if isinstance(ifd0.get(0x0112, 1), int) else 1


def read_photo(path):
    """(jpeg bytes, datetime taken or None, orientation) for a CR2 or JPEG."""
    data = Path(path).read_bytes()
    if data[:2] == b"\xff\xd8":
        taken, orient = None, 1
        try:
            from PIL import Image
            ex = Image.open(io.BytesIO(data)).getexif()
            orient = ex.get(0x0112, 1)
            taken = ex.get_ifd(0x8769).get(0x9003) or ex.get(0x0132)
        except Exception:
            pass
        return data, parse_taken(taken), orient
    jpeg, taken, orient = tiff_info(data)
    return jpeg, parse_taken(taken), orient


def parse_taken(text):
    try:
        return datetime.strptime(str(text).strip(), "%Y:%m:%d %H:%M:%S")
    except (TypeError, ValueError):
        return None


def cache_name(path):
    st = Path(path).stat()
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", str(Path(path).relative_to(PHOTOS)))
    return f"{safe}.{st.st_size}.{int(st.st_mtime)}.jpg"


def make_previews(path):
    """A small thumbnail for the grid and a big preview for the viewer, cached."""
    from PIL import Image, ImageOps
    name = cache_name(path)
    thumb, big = CACHE / "thumbs" / name, CACHE / "previews" / name
    if thumb.exists() and big.exists():
        return str(thumb), str(big)
    jpeg, _, orient = read_photo(path)
    if not jpeg:
        return "", ""
    private_dir(CACHE)
    private_dir(thumb.parent)
    private_dir(big.parent)
    for target, size in ((big, 1800), (thumb, 480)):
        img = Image.open(io.BytesIO(jpeg))
        img.draft("RGB", (size, size))
        img = img.convert("RGB")
        img.thumbnail((size, size))
        if orient in (3, 6, 8):
            img = img.transpose({3: Image.Transpose.ROTATE_180, 6: Image.Transpose.ROTATE_270,
                                 8: Image.Transpose.ROTATE_90}[orient])
        img.save(target, "JPEG", quality=85)
    return str(thumb), str(big)


def place(staged, card_file):
    """Move a downloaded file into <year>/<date>/ by the date it was taken."""
    try:
        _, taken, _ = read_photo(staged)
    except OSError:
        taken = None
    if taken is None:
        taken = datetime.fromtimestamp(card_file["mtime"] or time.time(), tz=timezone.utc).replace(tzinfo=None)
    folder = PHOTOS / f"{taken:%Y}" / f"{taken:%Y-%m-%d}"
    folder.mkdir(parents=True, exist_ok=True)
    dest = folder / card_file["name"]
    if dest.exists():
        if dest.stat().st_size == staged.stat().st_size:
            staged.unlink()
            return dest
        stem, ext, i = dest.stem, dest.suffix, 2
        while dest.exists():
            dest = folder / f"{stem}-{i}{ext}"
            i += 1
    shutil.move(str(staged), dest)
    return dest


# --- Commands -------------------------------------------------------------------

def alive(pidfile):
    pid = load(pidfile, 0)
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False


def cmd_status():
    cam = camera_usb()
    job = load(JOB, {})
    running = alive(PIDFILE)
    if job.get("state") in ("scanning", "downloading") and not running:
        job["state"] = "stopped"
    tag = load(TAGJOB, {})
    tag["queued"] = len(load(TAGQUEUE, []))
    tag["running"] = alive(TAGPID)
    reply({"ok": True, "camera": bool(cam), "product": cam["product"] if cam else "",
           "webcam": webcam_active(), "job": job, "running": running,
           "photosDir": str(PHOTOS), "claude": tag, "claudeAvailable": bool(shutil.which("claude"))})


def write_job(**kw):
    job = load(JOB, {})
    job.update(kw)
    job["updated"] = time.time()
    save(JOB, job)


def ranges(numbers):
    numbers = sorted(numbers)
    out, start, prev = [], None, None
    for n in numbers:
        if start is None:
            start = prev = n
        elif n == prev + 1:
            prev = n
        else:
            out.append(f"{start}-{prev}" if start != prev else str(start))
            start = prev = n
    if start is not None:
        out.append(f"{start}-{prev}" if start != prev else str(start))
    return ",".join(out)


def cmd_download():
    private_dir(STATE)
    pid = load(PIDFILE, 0)
    if pid:
        try:
            os.kill(int(pid), 0)
            reply({"ok": False, "error": "A download is already running."}, 1)
        except (OSError, ValueError):
            pass
    save(PIDFILE, os.getpid())
    child = {"proc": None}

    def stop(*_):
        if child["proc"]:
            child["proc"].terminate()
        write_job(state="stopped")
        PIDFILE.unlink(missing_ok=True)
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    save(JOB, {"state": "scanning", "started": time.time(), "updated": time.time()})
    if not camera_usb():
        write_job(state="error", error="No camera plugged in.")
        PIDFILE.unlink(missing_ok=True)
        reply({"ok": False, "error": "No camera plugged in."}, 1)
    if webcam_active():
        write_job(state="error", error="The webcam is using the camera.", webcam=True)
        PIDFILE.unlink(missing_ok=True)
        reply({"ok": False, "error": "The webcam is using the camera."}, 1)
    try:
        level = battery()
        files = list_card()
    except (RuntimeError, subprocess.SubprocessError) as err:
        write_job(state="error", error=str(err))
        PIDFILE.unlink(missing_ok=True)
        reply({"ok": False, "error": str(err)}, 1)

    ledger = load(LEDGER, {})
    new = [f for f in files if key(f) not in ledger]
    if os.environ.get("OMACANON_LIMIT"):            # testing: only the newest few
        new = new[-int(os.environ["OMACANON_LIMIT"]):]
    total_kb = sum(f["kb"] for f in new)
    write_job(state="downloading" if new else "done", battery=level, onCard=len(files),
              total=len(new), done=0, totalKB=total_kb, doneKB=0, current="", error="",
              brought=[])
    if not new:
        PIDFILE.unlink(missing_ok=True)
        reply({"ok": True, "brought": 0})

    by_number = {f["n"]: f for f in new}
    private_dir(STAGING)
    staging = STAGING.resolve()
    done, done_kb, days, failed = 0, 0, set(), 0
    started = time.time()

    def finish(staged_path):
        nonlocal done, done_kb, failed
        # Files are saved as their card number (never the camera's own name),
        # and must land straight inside the staging folder.
        staged = Path(staged_path)
        f = by_number.get(int(staged.name)) if staged.name.isdigit() else None
        if not f or staged.parent.resolve() != staging or not staged.is_file() or staged.is_symlink():
            failed += 1
            return
        if abs(staged.stat().st_size - f["kb"] * 1024) > 2048:
            staged.unlink(missing_ok=True)
            failed += 1
            return
        dest = place(staged, f)
        ledger[key(f)] = str(dest)
        save(LEDGER, ledger)
        days.add(dest.parent.name)
        try:
            make_previews(dest)
        except Exception:
            pass
        done += 1
        done_kb += f["kb"]
        rate = done_kb / max(1, time.time() - started)
        write_job(done=done, doneKB=done_kb, current=f["name"],
                  eta=int((total_kb - done_kb) / rate) if rate else 0, days=sorted(days))

    # gphoto2 takes one unbroken run of numbers at a time ("1-3,5-9" fails
    # with "File not found"), so each run gets its own gphoto2.
    returncode, err = 0, ""
    for run in ranges(f["n"] for f in new).split(","):
        # %n counts up from --filenumber once per saved file, so each file is
        # saved as its own card number and nothing the camera says goes in the path.
        cmd = ["gphoto2", "--get-file", run, "--filename", str(staging / "%n"),
               "--filenumber", run.split("-")[0], "--force-overwrite"]
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        child["proc"] = proc
        # No timeout for the whole run (a full card takes an hour), but a camera
        # that stops answering gets 3 minutes before its gphoto2 is ended.
        stall = {"t": None}

        def arm():
            if stall["t"]:
                stall["t"].cancel()
            stall["t"] = threading.Timer(180, proc.terminate)
            stall["t"].daemon = True
            stall["t"].start()

        arm()
        # Drain stderr as it comes (a full pipe would block gphoto2); keep the tail.
        err_tail = []

        def drain():
            for errline in proc.stderr:
                err_tail.append(errline)
                del err_tail[:-40]

        drainer = threading.Thread(target=drain, daemon=True)
        drainer.start()
        pending = None
        for line in proc.stdout:
            arm()
            m = re.match(r"Saving file as (.+)$", line.strip())
            if m:
                if pending:
                    finish(pending)
                pending = m.group(1)
        proc.wait()
        stall["t"].cancel()
        if pending:
            finish(pending)
        drainer.join(timeout=5)
        if proc.returncode != 0:
            returncode, err = proc.returncode, "".join(err_tail)
            break
    for left in STAGING.glob("*"):
        left.unlink(missing_ok=True)
    PIDFILE.unlink(missing_ok=True)
    if returncode != 0 and done < len(new):
        write_job(state="error", error=camera_error(err) + f" ({done} of {len(new)} came over.)")
        reply({"ok": False, "error": camera_error(err), "brought": done}, 1)
    write_job(state="done", failed=failed, current="", eta=0)
    reply({"ok": True, "brought": done, "failed": failed})


def cmd_stop():
    pid = load(PIDFILE, 0)
    if pid:
        try:
            os.kill(int(pid), signal.SIGTERM)
        except (OSError, ValueError):
            pass
    reply({"ok": True})


def photo_files(folder):
    return sorted(p for p in folder.iterdir() if p.is_file() and p.suffix.lower() in PHOTO_EXT)


def cmd_days():
    sent = set(load(SENT, {}))
    days = []
    if PHOTOS.exists():
        for year in PHOTOS.iterdir():
            if not (year.is_dir() and re.fullmatch(r"\d{4}", year.name)):
                continue
            for day in year.iterdir():
                if not (day.is_dir() and re.fullmatch(r"\d{4}-\d{2}-\d{2}", day.name)):
                    continue
                files = photo_files(day)
                if not files:
                    continue
                days.append({"date": day.name, "path": str(day), "count": len(files),
                             "sent": sum(1 for p in files if str(p) in sent),
                             "label": datetime.strptime(day.name, "%Y-%m-%d").strftime("%a %b %-d, %Y")})
    days.sort(key=lambda d: d["date"], reverse=True)
    reply({"ok": True, "days": days})


def cmd_day(date):
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", date or ""):
        reply({"ok": False, "error": "Bad date."}, 2)
    folder = PHOTOS / date[:4] / date
    if not folder.is_dir():
        reply({"ok": True, "photos": []})
    sent = set(load(SENT, {}))
    photos = []
    for p in photo_files(folder):
        try:
            thumb, big = make_previews(p)
        except Exception:
            thumb, big = "", ""
        photos.append({"path": str(p), "name": p.name, "thumb": thumb, "preview": big,
                       "sent": str(p) in sent, "mb": round(p.stat().st_size / 1e6, 1)})
    reply({"ok": True, "date": date, "photos": photos})


def read_request():
    """One JSON line on stdin: a list of paths, or {"paths": [...], "album": "..."}."""
    try:
        data = json.loads(sys.stdin.readline() or "[]")
    except ValueError:
        reply({"ok": False, "error": "Bad list."}, 2)
    if isinstance(data, list):
        data = {"paths": data}
    root = PHOTOS.resolve()
    good = []
    for p in data.get("paths") or []:
        rp = Path(str(p)).resolve()
        if root in rp.parents and rp.is_file():
            good.append(rp)
    return good, str(data.get("album") or "").strip()[:80], bool(data.get("claude"))


def paths_from_stdin():
    return read_request()[0]


def omaraw(ops):
    """Run OmaRAW headless with a list of operations; returns its answer."""
    catalog = ["--catalog", os.environ["OMACANON_CATALOG"]] if os.environ.get("OMACANON_CATALOG") else []
    try:
        out = subprocess.run(["omaraw", "--headless"] + catalog + ["apply", "-", "--keep-going"],
                             input=json.dumps({"ops": ops}), capture_output=True,
                             text=True, timeout=3600)
        return json.loads(out.stdout or "{}")
    except (OSError, subprocess.SubprocessError, ValueError):
        return {"ok": False, "error": "OmaRAW didn't answer."}


def omaraw_refused(result):
    if "already open" in str(result.get("error", "")):
        reply({"ok": False, "error": "Close the OmaRAW window first, then try again.", "omarawOpen": True}, 1)


def cmd_trash():
    paths = paths_from_stdin()
    moved = 0
    for p in paths:
        try:
            name = cache_name(p)
        except (OSError, ValueError):
            name = ""
        if subprocess.run(["gio", "trash", str(p)], capture_output=True, timeout=60).returncode == 0:
            moved += 1
            # Its previews are no use any more.
            if name:
                for kind in ("thumbs", "previews"):
                    (CACHE / kind / name).unlink(missing_ok=True)
    if moved < len(paths):
        reply({"ok": False, "trashed": moved,
               "error": f"{len(paths) - moved} couldn't go to the trash, so they were left alone."}, 1)
    reply({"ok": True, "trashed": moved})


def cmd_albums():
    result = omaraw([{"op": "catalog.albums"}])
    omaraw_refused(result)
    rows = result.get("results") or [{}]
    albums = rows[0].get("result") or []
    names = sorted({str(a.get("name", "")) for a in albums if isinstance(a, dict) and a.get("name")}, key=str.lower)
    reply({"ok": True, "albums": names})


def cmd_send():
    paths, album, claude = read_request()
    if not paths:
        reply({"ok": False, "error": "Nothing picked."}, 1)
    sent = load(SENT, {})
    if isinstance(sent, list):                      # older format: just paths
        sent = {p: 0 for p in sent}
    todo = [p for p in paths if str(p) not in sent]
    ids = [sent[str(p)] for p in paths if str(p) in sent and sent[str(p)]]
    if todo:
        # Tag while importing, then put her Automatic tagging switch back how it was
        # (the same thing `omaraw import --auto-tag` does).
        before = omaraw([{"op": "catalog.autoTagEnabled"}, {"op": "catalog.autoTagPaused"}])
        omaraw_refused(before)
        was = [row.get("result") for row in (before.get("results") or [])] + [None, None]
        ops = [{"op": "catalog.autoTagEnabled", "value": True}, {"op": "catalog.autoTagPaused", "value": False}]
        ops += [{"op": "catalog.importCapture", "args": [str(p)]} for p in todo]
        if isinstance(was[1], bool):
            ops.append({"op": "catalog.autoTagPaused", "value": was[1]})
        if isinstance(was[0], bool):
            ops.append({"op": "catalog.autoTagEnabled", "value": was[0]})
        result = omaraw(ops)
        omaraw_refused(result)
        rows = result.get("results") or []
        for p, row in zip(todo, rows[2:]):
            if row.get("ok", True) and not row.get("error"):
                pid = row.get("result")
                sent[str(p)] = pid if isinstance(pid, int) else 0
                if isinstance(pid, int) and pid > 0:
                    ids.append(pid)
        save(SENT, sent)
    done = sum(1 for p in todo if str(p) in sent)
    if done < len(todo):
        reply({"ok": False, "error": f"{done} of {len(todo)} went to OmaRAW.", "sent": done}, 1)

    in_album = 0
    if album and ids:
        result = omaraw([{"op": "catalog.albums"}])
        rows = result.get("results") or [{}]
        existing = [a for a in (rows[0].get("result") or [])
                    if isinstance(a, dict) and str(a.get("name", "")).lower() == album.lower()]
        album_id = existing[0].get("id") if existing else None
        if not album_id:
            made = omaraw([{"op": "catalog.createAlbum", "args": [album, 0]}])
            album_id = ((made.get("results") or [{}])[0]).get("result")
        if isinstance(album_id, int) and album_id > 0:
            ops = []
            for pid in ids:
                ops += [{"op": "catalog.select", "args": [pid]},
                        {"op": "catalog.addSelectionToAlbum", "args": [album_id]}]
            result = omaraw(ops)
            in_album = len(ids) if result.get("ok") else 0
    queued = 0
    if claude:
        queue = load(TAGQUEUE, [])
        waiting = {q["id"] for q in queue}
        for p in paths:
            pid = sent.get(str(p))
            if isinstance(pid, int) and pid > 0 and pid not in waiting:
                queue.append({"id": pid, "path": str(p), "album": album})
                queued += 1
        save(TAGQUEUE, queue)
        if queued:
            save(TAGJOB, {"state": "waiting", "done": 0, "total": len(queue), "error": "", "updated": time.time()})
    reply({"ok": True, "sent": done, "already": len(paths) - len(todo), "album": album if in_album else "",
           "inAlbum": in_album, "claude": queued})


# ---------------------------------------------------------------------------
# Claude tagging: Claude only looks at small JPEG copies and answers with
# words; this helper writes those words into OmaRAW. Claude gets the Read tool
# on one folder and nothing else.
# ---------------------------------------------------------------------------

TAG_BATCH = 6
TAG_PROMPT = """You are tagging family photos so they are easy to find later in a photo library.
Use the Read tool to look at each of these image files:
{files}
{album}
For every photo give:
- "title": 2 to 6 words, plain, like "Kids painting at the craft table"
- "caption": one short sentence about what is happening
- "keywords": 4 to 8 lowercase keywords: subjects, activity, place or setting, season, notable colours or objects
Never guess anyone's name, age, identity or personal details. Describe what is visible.
Answer with JSON only, no other text:
{{"photos": [{{"file": "<file name>", "title": "...", "caption": "...", "keywords": ["..."]}}]}}"""


def write_tag(**kw):
    job = load(TAGJOB, {})
    job.update(kw)
    job["updated"] = time.time()
    save(TAGJOB, job)


def tag_copy(item):
    """A 1024 px JPEG of the photo for Claude to look at."""
    src = Path(item["path"])
    _, big = make_previews(src)
    out = CACHE / "claude" / f"{item['id']}.jpg"
    private_dir(CACHE)
    private_dir(out.parent)
    from PIL import Image
    with Image.open(big) as img:
        img.thumbnail((1024, 1024))
        img.convert("RGB").save(out, "JPEG", quality=85)
    return out


def ask_claude(batch):
    folder = CACHE / "claude"
    files = {}
    try:
        for item in batch:
            files[tag_copy(item).name] = item
        return claude_answer(folder, files, batch)
    finally:
        # The small copies only live for this one question.
        for name in files:
            (folder / name).unlink(missing_ok=True)


def claude_answer(folder, files, batch):
    albums = sorted({i["album"] for i in batch if i.get("album")})
    prompt = TAG_PROMPT.format(
        files="\n".join(str(folder / name) for name in files),
        album=f"They are from an album called \"{albums[0]}\"; use that as context.\n" if albums else "")
    env = {k: v for k, v in os.environ.items() if k != "CLAUDE_CODE_PLUGIN_DIRS"}
    out = subprocess.run(
        ["claude", "-p", prompt, "--model", "sonnet", "--tools", "Read",
         "--allowedTools", f"Read({folder}/**)", "--setting-sources", "local",
         "--strict-mcp-config", "--no-session-persistence", "--output-format", "json"],
        cwd=folder, env=env, capture_output=True, text=True, timeout=900)
    text = out.stdout
    try:
        result = json.loads(text[text.index("{"):]).get("result", "")
        answer = json.loads(result[result.index("{"):result.rindex("}") + 1])
    except (ValueError, AttributeError):
        raise RuntimeError("Claude didn't answer. Is Claude signed in?")
    tags = {}
    for row in answer.get("photos") or []:
        item = files.get(Path(str(row.get("file", ""))).name)
        if item:
            tags[item["id"]] = row
    return tags


def write_tags(tags):
    ops = []
    for pid, row in tags.items():
        title = str(row.get("title") or "").strip()[:120]
        caption = str(row.get("caption") or "").strip()[:500]
        if title:
            ops.append({"op": "catalog.setTitle", "args": {"text": title, "id": pid}})
        if caption:
            ops.append({"op": "catalog.setCaption", "args": {"text": caption, "id": pid}})
        ops.append({"op": "catalog.select", "args": [pid]})
        for word in (row.get("keywords") or [])[:10]:
            word = str(word).strip().lower()[:40]
            if word:
                ops.append({"op": "catalog.addKeyword", "args": [word]})
    return omaraw(ops) if ops else {"ok": True}


def cmd_claude_tag():
    private_dir(STATE)
    if alive(TAGPID):
        reply({"ok": False, "error": "Claude is already tagging."}, 1)
    save(TAGPID, os.getpid())

    def stop(*_):
        TAGPID.unlink(missing_ok=True)
        write_tag(state="stopped")
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    done = 0
    total = len(load(TAGQUEUE, []))
    write_tag(state="tagging", done=0, total=total, error="")
    while True:
        queue = load(TAGQUEUE, [])
        if not queue:
            break
        batch = [q for q in queue[:TAG_BATCH] if Path(q["path"]).is_file()]
        if batch:
            try:
                tags = ask_claude(batch)
            except (RuntimeError, OSError, subprocess.SubprocessError) as err:
                TAGPID.unlink(missing_ok=True)
                write_tag(state="error", error=str(err))
                reply({"ok": False, "error": str(err)}, 1)
            # OmaRAW can only be open once: wait for her to close the window.
            while True:
                result = write_tags(tags)
                if "already open" not in str(result.get("error", "")):
                    break
                write_tag(state="waiting-omaraw")
                time.sleep(15)
        taken = {q["id"] for q in queue[:TAG_BATCH]}
        save(TAGQUEUE, [q for q in load(TAGQUEUE, []) if q["id"] not in taken])
        done += len(taken)
        total = done + len(load(TAGQUEUE, []))
        write_tag(state="tagging", done=done, total=total)
    TAGPID.unlink(missing_ok=True)
    write_tag(state="done", done=done, total=done)
    reply({"ok": True, "tagged": done})


def hypr(dispatch):
    subprocess.run(["hyprctl", "dispatch", dispatch], capture_output=True, timeout=5)


def cmd_open(target):
    """OmaCanon floats, so a normal (tiled) window would open behind it. Open
    the folder or OmaRAW, wait for its window, then float it on top."""
    if target == "omaraw":
        cmd = ["omaraw"]
        try:
            mon = next(m for m in json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                       text=True, timeout=5).stdout) if m.get("focused"))
            scale = mon.get("scale") or 1
            size = (int(mon["width"] / scale * 0.85), int(mon["height"] / scale * 0.85))
        except (StopIteration, ValueError, KeyError, OSError, subprocess.SubprocessError):
            size = (1600, 1000)
    else:
        folder = Path(target or PHOTOS).resolve()
        if folder != PHOTOS.resolve() and PHOTOS.resolve() not in folder.parents:
            reply({"ok": False, "error": "That folder isn't a photo folder."}, 2)
        cmd, size = ["xdg-open", str(folder)], (1200, 760)

    def windows():
        try:
            out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=5).stdout
            return {c["address"] for c in json.loads(out)}
        except (ValueError, KeyError, OSError, subprocess.SubprocessError):
            return set()

    before = windows()
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    new = set()
    for _ in range(60):                      # up to 15 s (OmaRAW takes a moment)
        time.sleep(0.25)
        new = windows() - before
        if new:
            break
    if not new:
        reply({"ok": False, "error": "The window didn't show up."}, 1)
    address = sorted(new)[0]
    if not re.fullmatch(r"0x[0-9a-fA-F]+", address):   # goes into a Hyprland Lua line
        reply({"ok": False, "error": "Unexpected window id."}, 1)
    time.sleep(0.2)
    hypr(f"hl.dsp.focus({{ window = 'address:{address}' }})")
    hypr("hl.dsp.window.float({ action = 'enable' })")
    hypr(f"hl.dsp.window.resize({{ x = {size[0]}, y = {size[1]} }})")
    hypr("hl.dsp.window.center()")
    reply({"ok": True, "window": address})


def cmd_webcam_off():
    if shutil.which("dslr-webcam"):
        subprocess.run(["dslr-webcam", "off"], capture_output=True, timeout=20)
    reply({"ok": True, "webcam": webcam_active()})


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "status":
        cmd_status()
    elif cmd == "download":
        cmd_download()
    elif cmd == "stop":
        cmd_stop()
    elif cmd == "days":
        cmd_days()
    elif cmd == "day":
        cmd_day(args[1] if len(args) > 1 else "")
    elif cmd == "trash":
        cmd_trash()
    elif cmd == "send":
        cmd_send()
    elif cmd == "albums":
        cmd_albums()
    elif cmd == "claude-tag":
        cmd_claude_tag()
    elif cmd == "open":
        cmd_open(args[1] if len(args) > 1 else "")
    elif cmd == "webcam-off":
        cmd_webcam_off()
    else:
        reply({"ok": False, "error": "usage: omacanonctl status|download|stop|days|day DATE|trash|send|albums|claude-tag|open|webcam-off"}, 2)


if __name__ == "__main__":
    main()
